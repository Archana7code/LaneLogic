# LaneLogic Backend - Environment Variables
# ===========================================
# Copy this file to .env and set values for your environment.
# DO NOT commit .env — it is gitignored.

# Frontend origin for CORS (use * only during development/testing).
# Local development:
FRONTEND_ORIGIN=http://localhost:5173

# Production (set to your actual Render Static Site URL):
# FRONTEND_ORIGIN=https://<your-frontend-name>.onrender.com

# SQLite database path.
# Local development: leave unset (defaults to ./lanelogic.db in person3_backend/)
# Production with Render persistent disk mounted at /data:
# DATABASE_URL=sqlite:////data/lanelogic.db
